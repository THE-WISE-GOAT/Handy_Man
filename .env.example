DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=handy_man_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
gemini_api_key=your-gemini-api-key
nvidia_api_key=your-nvidia-api-key

# Browser origins allowed to call the API (comma-separated, no spaces).
# The defaults in config.py already cover local Vite dev servers, so this can
# stay commented out for development. When the frontend is deployed, add its
# origin here — a missing origin makes every browser request fail with a CORS
# error even though the API itself is healthy.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-app.vercel.app

PUBLIC_API_URL=http://localhost:8000
CUSTOMER_APP_URL=http://localhost:5173
WORKER_APP_URL=http://localhost:5174
MAP_STANDALONE_URL=http://localhost:5174
POSTGRES_EXPOSE_PORT=5432
BACKEND_PORT=8000
CUSTOMER_APP_PORT=5173
WORKER_APP_PORT=5174
